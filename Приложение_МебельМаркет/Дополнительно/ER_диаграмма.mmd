    Роли {
      int КодРоли PK
      string Название
    }
    Пользователи {
      int КодПользователя PK
      int КодРоли FK
      int КодПокупателя FK
      string ФИО
      string Логин UK
      string Пароль
    }
    Покупатели {
      int КодПокупателя PK
      string ФИО
      string Телефон
      string Адрес
    }
    Категории {
      int КодКатегории PK
      string Название UK
    }
    Производители {
      int КодПроизводителя PK
      string Название UK
    }
    Поставщики {
      int КодПоставщика PK
      string Название UK
    }
    Склады {
      int КодСклада PK
      string Название UK
      string Адрес
    }
    Товары {
      int КодТовара PK
      string Артикул UK
      string Наименование
      int КодКатегории FK
      int КодПроизводителя FK
      int КодПоставщика FK
      currency Цена
      float Скидка
    }
    Остатки {
      int КодТовара PK, FK
      int КодСклада PK, FK
      int Количество
    }
    Заказы {
      int КодЗаказа PK
      int КодПокупателя FK
      int КодСклада FK
      date ДатаЗаказа
      date ДатаДоставки
      string Статус
    }
    СоставЗаказа {
      int КодЗаказа PK, FK
      int КодТовара PK, FK
      int Количество
      currency ЦенаНаМоментЗаказа
    }
